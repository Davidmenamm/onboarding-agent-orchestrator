# --- LLM (only external service) ---
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=z-ai/glm-5.3-flashx
LLM_FALLBACK_MODELS=z-ai/glm-5.3-flash,z-ai/glm-4.7-flash

# --- Database ---
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onboarding
DATABASE_URL=postgresql://onboarding:change-me@localhost:5442/onboarding

# --- Secrets (generate with: make secrets) ---
PII_ENCRYPTION_KEY=   # 32-byte base64, AES-GCM for PII columns
PII_HASH_PEPPER=      # HMAC pepper for document_id lookup hash
LANGGRAPH_AES_KEY=    # 16/24/32 chars, encrypts checkpoints
JWT_PRIVATE_KEY_PATH=./infra/dev-jwt/private.pem

# --- Langfuse (optional, profile: observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
